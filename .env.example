# Copy to .env and fill in. Only these keys are read by the app.

# "openrouter" (default) or "fake": an offline scripted interviewer/judge for developing without a key.
LLM_PROVIDER=openrouter

# OpenRouter API key (https://openrouter.ai/keys). Required for real LLM calls.
OPENROUTER_API_KEY=

# OpenRouter model id. Free models are listed at https://openrouter.ai/models?q=free
# If your workspace has an allow-list guardrail, pick one of its models instead, e.g. openai/gpt-4.1-mini
LLM_MODEL=google/gemma-4-31b-it:free

# JEV model for the JEV Judge (OpenRouter id). Pin the version: confidences only mean something for one version.
JEV_MODEL=typesafe/jev-1.13

# Voice Interviews: transcription of spoken Answers and the interviewer's voice (OpenRouter ids).
# Both must be on your OpenRouter allow-list. The Persona voices in models.py belong to the TTS model.
STT_MODEL=openai/gpt-4o-mini-transcribe
TTS_MODEL=google/gemini-3.8-flash-tts

# SQLAlchemy URL. Default is a SQLite file in the repo root.
DATABASE_URL=sqlite:///./interview.db

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
